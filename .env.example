# Copie para .env (docker compose usa este arquivo)
DJANGO_SECRET_KEY=troque-esta-chave-em-producao
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

POSTGRES_DB=fleet
POSTGRES_USER=fleet
POSTGRES_PASSWORD=fleet

FRONTEND_URL=http://localhost:5173

# E-mail: em dev, o MailHog (porta 1025) captura tudo. Em produção, use seu SMTP:
# EMAIL_HOST=smtp.seudominio.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=usuario
# EMAIL_HOST_PASSWORD=senha
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=FleetTrack <no-reply@seudominio.com>

SPEED_LIMIT_KMH=90
ALERT_DAYS_BEFORE_EXPIRY=30
ALERT_KM_BEFORE_MAINTENANCE=500

# Observabilidade (opcional)
LOG_LEVEL=INFO
# SENTRY_DSN=
